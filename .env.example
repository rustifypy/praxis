# Docker: Cube Store publishes no multi-arch latest.
# Apple Silicon -> arm64v8. Intel/AMD -> latest.
CUBESTORE_TAG=arm64v8

# Cube
# The source the agent queries. Ports are assigned in sources.yml.
CUBE_URL=http://localhost:4001
CUBE_BASE_PATH=/cubejs-api
CUBE_API_SECRET=dev-secret-change-me
CUBEJS_API_SECRET=dev-secret-change-me

# Model — Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Only needed if the deployment is not named after the model below.
AZURE_OPENAI_DEPLOYMENT=
QUERY_MODEL=azure_openai:gpt-5.1

# Cube dev mode: serves the playground UI at each source's port.
# It also SKIPS JWT verification — /v1/meta and /v1/load answer unauthenticated.
# Keep it true for local work; it must be false anywhere real.
CUBEJS_DEV_MODE=true

# Limits
MAX_ROWS=5000
QUERY_TIMEOUT_S=60

GROUNDING_DIR=grounding

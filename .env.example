# The portal's own settings, and nothing else. Everything the Cube deployment is run with —
# warehouse credentials, its API secret, the model store's tokens, the ports — is generated by
# the portal when you connect a database and belongs in the service's own `.env`, under
# `services/`. Do not put it here: `Settings` does not read it, and a second copy is one that
# drifts.

# Model — Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Only needed if the deployment is not named after the model below.
AZURE_OPENAI_DEPLOYMENT=
QUERY_MODEL=azure_openai:gpt-5.1

# Reasoning summaries need api-version 2025-03-01-preview or later, and "auto" often emits
# nothing on short planning calls — which shows up as an empty thinking panel.
REASONING_EFFORT=medium
REASONING_SUMMARY=detailed

# Limits
MAX_ROWS=5000
QUERY_TIMEOUT_S=60

# Where the portal listens, and where it keeps everything: analyst.db, the job lock and the
# chat workspaces. A scratch DATA_DIR is a whole scratch install, connection included.
WEB_HOST=127.0.0.1
WEB_PORT=8420
DATA_DIR=~/.analyst

# Show a script and wait for a click before running it. Not a safety gate — the sandbox's
# --network none is — but the only moment you can read what the agent wrote.
APPROVE_SCRIPTS=true

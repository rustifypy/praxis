# Docker: Cube Store publishes no multi-arch latest.
# Apple Silicon -> arm64v8. Intel/AMD -> latest.
CUBESTORE_TAG=arm64v8

# Cube
# The source the agent queries. Ports are assigned in sources.yml.
CUBE_URL=http://localhost:4001
CUBE_BASE_PATH=/cubejs-api
# The agent signs with the first, Cube verifies with the second — they must be equal.
# HS256 requires at least 32 bytes; mint_token refuses to sign below that. Generate one:
#   python -c 'import secrets; print(secrets.token_urlsafe(36))'
# Changing it means `make down && make up`, or Cube keeps the old key.
CUBE_API_SECRET=replace-me-with-a-32-byte-or-longer-random-secret
CUBEJS_API_SECRET=replace-me-with-a-32-byte-or-longer-random-secret

# Model — Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Only needed if the deployment is not named after the model below.
AZURE_OPENAI_DEPLOYMENT=
QUERY_MODEL=azure_openai:gpt-5.1

# Reasoning summaries, shown in the web transcript. They need the Responses API, which
# Azure serves only on 2025-03-01-preview and later — the model refuses to start below
# it. "auto" often decides a short planning call is not worth summarizing, which leaves
# the thinking panel blank; "detailed" is why you turned this on.
REASONING_EFFORT=medium
REASONING_SUMMARY=detailed

# Cube dev mode: serves the playground UI at each source's port.
# It also SKIPS JWT verification — /v1/meta and /v1/load answer unauthenticated.
# Keep it true for local work; it must be false anywhere real.
CUBEJS_DEV_MODE=true

# Limits
MAX_ROWS=5000
QUERY_TIMEOUT_S=60

GROUNDING_DIR=grounding

# Web portal. Chat history and the LangGraph checkpointer share DATA_DIR/analyst.db.
WEB_HOST=127.0.0.1
WEB_PORT=8420
DATA_DIR=~/.analyst

# The portal's own settings, and nothing else. Everything a deployment is run with — warehouse
# credentials, its API secret, the model store's tokens, the ports — is generated by the portal
# into a compose file you download when you connect a database. Do not put any of it here:
# `Settings` does not read it, and a second copy is one that drifts.

# Model — `<provider>:<model>`. One of azure_openai, openai, openai_compatible, anthropic,
# google_genai, ollama, litellm. Fill in only the chosen provider's lines; docs/operations/
# configuration.md lists them all, and praxis refuses to start while the chosen one's key is empty.
QUERY_MODEL=azure_openai:gpt-5.1
# Model generation makes one structured call per table. Empty uses QUERY_MODEL.
MODELGEN_MODEL=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Only needed if the deployment is not named after the model above.
AZURE_OPENAI_DEPLOYMENT=

# OpenAI
OPENAI_API_KEY=

# A local server speaking OpenAI's chat completions (vLLM, LM Studio, llama.cpp)
OPENAI_COMPATIBLE_BASE_URL=

# Anthropic — needs `praxis[anthropic]`
ANTHROPIC_API_KEY=

# Gemini — needs `praxis[google]`
GOOGLE_API_KEY=

# Ollama — needs `praxis[ollama]`. Reasoning only for a model that can think; Ollama refuses
# the request otherwise.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING=false

# Reasoning summaries on Azure need api-version 2025-03-01-preview or later, and "auto" often
# emits nothing on short planning calls — which shows up as an empty thinking panel. An empty
# REASONING_EFFORT asks no provider for reasoning.
REASONING_EFFORT=medium
REASONING_SUMMARY=detailed

# A chat whose earlier answers came from another provider: refuse, or new_thread.
ON_PROVIDER_CHANGE=refuse

# Limits
MAX_ROWS=5000
QUERY_TIMEOUT_S=60

# Where the portal listens, and where it keeps everything: praxis.db, the job lock and the
# chat workspaces. A scratch DATA_DIR is a whole scratch install, connection included.
WEB_HOST=127.0.0.1
WEB_PORT=8420
DATA_DIR=~/.praxis

# Show a script and wait for a click before running it. Not a safety gate — the sandbox holding
# no credential is — but the only moment you can read what the agent wrote.
APPROVE_SCRIPTS=true

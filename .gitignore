# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Tool caches
.pytest_cache/
.ruff_cache/
# A knowledge graph regenerated from the tree, plus its fingerprint baseline — ~1MB of
# JSON that is stale the moment anything is committed.
.understand-anything/

# Virtual environments
.venv/

# Editors and OS
.idea/
.vscode/
.DS_Store

# Local config
.env
.env.cube
# A rotation leaves a copy of .env behind. Plaintext, so never committable.
.env.*-backup

# Frontend. Only node_modules and the tsc cache are ignored — the build output at
# src/analyst_agent/web/static/ IS committed, and `analyst` serves a 503 without it.
src/web/node_modules/
src/web/tsconfig.tsbuildinfo

/cube/
.cube-probe/
skills-lock.json
.claude/
.agents/
